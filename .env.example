# Configuración general del servidor (12-Factor App - Sin secretos reales)
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Configuración de la API y Políticas de Negocio (BR-12)
API_TITLE=FarmaExpress API
DIAS_PROXIMIDAD_CADUCIDAD=30

# Configuración de Base de Datos (SQLite local por defecto o PostgreSQL en Docker)
DATABASE_URL=sqlite:///./farmaexpress.db
POSTGRES_DB=farmaexpress
POSTGRES_USER=farmaexpress
POSTGRES_PASSWORD=change_me_in_local_env
